# 开发环境示例；复制为 .env 后按需修改。不要提交真实密钥。
APP_ENV=dev
HTTP_ADDR=:8080
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres@localhost:5432/ai_shuati_dev?sslmode=disable
SESSION_TTL=720h
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=10485760
# 开发环境默认在同一进程内运行 worker（生产环境用 cmd/worker 独立进程）
RUN_WORKER=true
WORKER_ID=dev-worker
WORKER_CONCURRENCY=2
# AI 为可选能力：未配置时确定性判分完全可用，无答案题会显示为待分析
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=60s
